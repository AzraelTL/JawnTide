# JawnTide database backup every 15 minutes (installed as /etc/cron.d/jawntide-backup).
# jawntide-backup.sh keeps the last 3 days of backups.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/15 * * * * root flock -n /run/jawntide-backup.lock /usr/local/bin/jawntide-backup.sh >> /var/log/jawntide-backup.log 2>&1
